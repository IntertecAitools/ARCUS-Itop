# Server-side only. Never prefix any of these with NEXT_PUBLIC_ —
# that prefix inlines the value into the browser bundle.

ITOP_REST_URL=http://localhost:8080/webservices/rest.php
ITOP_REST_USER=svc_web_demo
ITOP_REST_PASSWORD=
ITOP_REST_VERSION=1.3

# Public key, safe by design. The only one that may carry the prefix.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

RESEND_API_KEY=
SALES_NOTIFY_EMAIL=sales@weftbase.com
