# Pinned versions of the security tools (security/README.md). The install
# script checks each download against the SHA-256 below, taken from the
# project's own release checksums. To upgrade: pick a release at least two
# weeks old, update the version and the checksum together, run the scans.

# Trivy: dependency and infrastructure-as-code scanning.
# https://github.com/aquasecurity/trivy/releases (trivy_<v>_Linux-64bit.tar.gz)
TRIVY_VERSION=0.76.1
TRIVY_SHA256=c7cbe3137fb8a48a17574bede3dd6beb16742d1e9772929940fc90082c39d9c0

# Gitleaks: secret scanning.
# https://github.com/gitleaks/gitleaks/releases (gitleaks_<v>_linux_x64.tar.gz)
GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb

# Semgrep (OSS): static code analysis, installed from PyPI.
SEMGREP_VERSION=1.183.0
