<?xml version="1.0" encoding="UTF-8"?>
<itop_design xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="3.2">
  <!-- A Dispatched state on Incident and UserRequest: the ticket is with a
       team, nobody in it has taken it yet.

         New (Approved, for a request) ── ev_dispatch ──> Dispatched
         Escalated TTO ───────────────── ev_dispatch ──> Dispatched
         Dispatched ── ev_dispatch ──> Dispatched (another team)
         Dispatched ── ev_assign ────> Assigned   (an agent of that team)
         Dispatched ── ev_timeout ───> Escalated TTO (TTO keeps running)
         Dispatched ── ev_autoresolve > Resolved   (as from New)

       The team is required to dispatch, the agent is not. -->
  <!-- No comment may precede <itop_design>: iTop reads the document's first
       node as the delta (ModelFactory::LoadModule), so it would skip it all. -->
  <classes>
    <class id="Incident" _delta="must_exist">
      <fields>
        <field id="status" _delta="must_exist">
          <values>
            <value id="dispatched" _delta="define">
              <code>dispatched</code>
              <rank>15</rank>
            </value>
          </values>
        </field>
        <!-- When the ticket was last sent to a team: how long it has
             waited in the team's queue. -->
        <field id="dispatch_date" xsi:type="AttributeDateTime" _delta="define">
          <sql>dispatch_date</sql>
          <default_value/>
          <is_null_allowed>true</is_null_allowed>
        </field>
        <field id="tto" _delta="must_exist">
          <states>
            <state id="dispatched" _delta="define"/>
          </states>
        </field>
        <field id="ttr" _delta="must_exist">
          <states>
            <state id="dispatched" _delta="define"/>
          </states>
        </field>
      </fields>
      <lifecycle>
        <stimuli>
          <stimulus id="ev_dispatch" xsi:type="StimulusUserAction" _delta="define"/>
        </stimuli>
        <states>
          <state id="new" _delta="must_exist">
            <flags>
              <attribute id="dispatch_date" _delta="define">
                <hidden/>
              </attribute>
            </flags>
            <transitions>
              <transition id="ev_dispatch" _delta="define">
                <target>dispatched</target>
                <actions>
                  <action>
                    <verb>SetCurrentDate</verb>
                    <params>
                      <param xsi:type="attcode">dispatch_date</param>
                    </params>
                  </action>
                </actions>
              </transition>
            </transitions>
          </state>
          <state id="escalated_tto" _delta="must_exist">
            <transitions>
              <transition id="ev_dispatch" _delta="define">
                <target>dispatched</target>
                <actions>
                  <action>
                    <verb>SetCurrentDate</verb>
                    <params>
                      <param xsi:type="attcode">dispatch_date</param>
                    </params>
                  </action>
                </actions>
              </transition>
            </transitions>
          </state>
          <state id="dispatched" _delta="define">
            <inherit_flags_from>new</inherit_flags_from>
            <flags>
              <attribute id="team_id">
                <mandatory/>
                <must_prompt/>
              </attribute>
              <attribute id="agent_id"/>
              <attribute id="dispatch_date">
                <read_only/>
              </attribute>
            </flags>
            <transitions>
              <transition id="ev_assign">
                <target>assigned</target>
                <actions>
                  <action>
                    <verb>SetCurrentDate</verb>
                    <params>
                      <param xsi:type="attcode">assignment_date</param>
                    </params>
                  </action>
                </actions>
              </transition>
              <transition id="ev_dispatch">
                <target>dispatched</target>
                <actions>
                  <action>
                    <verb>SetCurrentDate</verb>
                    <params>
                      <param xsi:type="attcode">dispatch_date</param>
                    </params>
                  </action>
                </actions>
              </transition>
              <transition id="ev_timeout">
                <target>escalated_tto</target>
                <actions/>
              </transition>
              <transition id="ev_autoresolve">
                <target>resolved</target>
                <actions>
                  <action>
                    <verb>SetCurrentDate</verb>
                    <params>
                      <param xsi:type="attcode">resolution_date</param>
                    </params>
                  </action>
                  <action>
                    <verb>SetElapsedTime</verb>
                    <params>
                      <param xsi:type="attcode">time_spent</param>
                      <param xsi:type="attcode">start_date</param>
                      <param xsi:type="string">DefaultWorkingTimeComputer</param>
                    </params>
                  </action>
                  <action>
                    <verb>ResolveChildTickets</verb>
                    <params/>
                  </action>
                </actions>
              </transition>
            </transitions>
          </state>
        </states>
      </lifecycle>
    </class>

    <class id="UserRequest" _delta="must_exist">
      <fields>
        <field id="status" _delta="must_exist">
          <values>
            <value id="dispatched" _delta="define">
              <code>dispatched</code>
              <rank>15</rank>
            </value>
          </values>
        </field>
        <field id="dispatch_date" xsi:type="AttributeDateTime" _delta="define">
          <sql>dispatch_date</sql>
          <default_value/>
          <is_null_allowed>true</is_null_allowed>
        </field>
        <field id="tto" _delta="must_exist">
          <states>
            <state id="dispatched" _delta="define"/>
          </states>
        </field>
        <field id="ttr" _delta="must_exist">
          <states>
            <state id="dispatched" _delta="define"/>
          </states>
        </field>
      </fields>
      <lifecycle>
        <stimuli>
          <stimulus id="ev_dispatch" xsi:type="StimulusUserAction" _delta="define"/>
        </stimuli>
        <states>
          <state id="new" _delta="must_exist">
            <flags>
              <attribute id="dispatch_date" _delta="define">
                <hidden/>
              </attribute>
            </flags>
            <transitions>
              <transition id="ev_dispatch" _delta="define">
                <target>dispatched</target>
                <actions>
                  <action>
                    <verb>SetCurrentDate</verb>
                    <params>
                      <param xsi:type="attcode">dispatch_date</param>
                    </params>
                  </action>
                </actions>
              </transition>
            </transitions>
          </state>
          <state id="escalated_tto" _delta="must_exist">
            <transitions>
              <transition id="ev_dispatch" _delta="define">
                <target>dispatched</target>
                <actions>
                  <action>
                    <verb>SetCurrentDate</verb>
                    <params>
                      <param xsi:type="attcode">dispatch_date</param>
                    </params>
                  </action>
                </actions>
              </transition>
            </transitions>
          </state>
          <!-- An approved request is routed like a new one. -->
          <state id="approved" _delta="must_exist">
            <transitions>
              <transition id="ev_dispatch" _delta="define">
                <target>dispatched</target>
                <actions>
                  <action>
                    <verb>SetCurrentDate</verb>
                    <params>
                      <param xsi:type="attcode">dispatch_date</param>
                    </params>
                  </action>
                </actions>
              </transition>
            </transitions>
          </state>
          <state id="dispatched" _delta="define">
            <inherit_flags_from>new</inherit_flags_from>
            <flags>
              <attribute id="team_id">
                <mandatory/>
                <must_prompt/>
              </attribute>
              <attribute id="agent_id"/>
              <attribute id="dispatch_date">
                <read_only/>
              </attribute>
            </flags>
            <transitions>
              <transition id="ev_assign">
                <target>assigned</target>
                <actions>
                  <action>
                    <verb>SetCurrentDate</verb>
                    <params>
                      <param xsi:type="attcode">assignment_date</param>
                    </params>
                  </action>
                </actions>
              </transition>
              <transition id="ev_dispatch">
                <target>dispatched</target>
                <actions>
                  <action>
                    <verb>SetCurrentDate</verb>
                    <params>
                      <param xsi:type="attcode">dispatch_date</param>
                    </params>
                  </action>
                </actions>
              </transition>
              <transition id="ev_timeout">
                <target>escalated_tto</target>
                <actions/>
              </transition>
              <transition id="ev_autoresolve">
                <target>resolved</target>
                <actions>
                  <action>
                    <verb>SetCurrentDate</verb>
                    <params>
                      <param xsi:type="attcode">resolution_date</param>
                    </params>
                  </action>
                  <action>
                    <verb>SetElapsedTime</verb>
                    <params>
                      <param xsi:type="attcode">time_spent</param>
                      <param xsi:type="attcode">start_date</param>
                      <param xsi:type="string">DefaultWorkingTimeComputer</param>
                    </params>
                  </action>
                  <action>
                    <verb>ResolveChildTickets</verb>
                    <params/>
                  </action>
                </actions>
              </transition>
            </transitions>
          </state>
        </states>
      </lifecycle>
    </class>
  </classes>

  <!-- Service Desk Agent and Support Agent dispatch (Administrator and
       iTop's SuperUser profile already may: itop-profiles-itil grants it). -->
  <user_rights>
    <profiles>
      <profile id="4" _delta="must_exist">
        <groups>
          <group id="Incident" _delta="must_exist">
            <actions>
              <action id="stimulus:ev_dispatch" _delta="define">allow</action>
            </actions>
          </group>
          <group id="UserRequest" _delta="must_exist">
            <actions>
              <action id="stimulus:ev_dispatch" _delta="define">allow</action>
            </actions>
          </group>
        </groups>
      </profile>
      <profile id="5" _delta="must_exist">
        <groups>
          <group id="Incident" _delta="must_exist">
            <actions>
              <action id="stimulus:ev_dispatch" _delta="define">allow</action>
            </actions>
          </group>
          <group id="UserRequest" _delta="must_exist">
            <actions>
              <action id="stimulus:ev_dispatch" _delta="define">allow</action>
            </actions>
          </group>
        </groups>
      </profile>
    </profiles>
  </user_rights>
</itop_design>
