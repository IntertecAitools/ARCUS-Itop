# Production settings for docker/docker-compose.prod.yml: compose values and
# the BFF. Copy to docker/prod.env (gitignored) and fill in; iTop's own side
# is docker/itop.env. docs/deployment.md explains each one;
# backend/.env.example has the full list with development defaults.
# A value containing $ must be in single quotes.

# --- Compose (not read by the BFF) -------------------------------------------
WEB_BIND=127.0.0.1
WEB_PORT=8088
# Image tag for arcus-bff / arcus-web.
ARCUS_VERSION=latest
# Compiled into the frontend bundle at build time.
VITE_APP_NAME=Intertec
VITE_PLATFORM_NAME=Servicedesk
VITE_DEFAULT_LOCALE=en
# bundled-db: run MySQL in this stack. Empty with an existing MySQL (then set
# ITOP_DB_HOST in itop.env and SESSION_DB_HOST below to it).
COMPOSE_PROFILES=bundled-db
# Where the backup job writes, on the host (relative to docker/).
BACKUP_DIR=../backups

# --- iTop --------------------------------------------------------------------
# The `itop` service, on the internal network.
ITOP_BASE_URL=http://itop
# Service account: Administrator + REST Services User. itop-setup creates it
# with this password; itop-cron runs iTop's background jobs as it.
ITOP_USER=arcus-service
ITOP_PASSWORD=
ITOP_REST_VERSION=1.4
ITOP_TIMEOUT_MS=30000
ITOP_RETRIES=2
# iTop's time zone: itop-setup writes it into config-itop.php, the BFF reads
# iTop's datetimes in it. Set it once, before the first install.
ITOP_TIMEZONE=Europe/Paris
ITOP_DEFAULT_COMMENT=via arcus-backend
ITOP_DEFAULT_ORG_ID=

# --- BFF ---------------------------------------------------------------------
LOG_LEVEL=info
# The public address of the app (scheme + host, no path). Writes from any
# other origin are refused.
CORS_ORIGINS=https://helpdesk.example.com
APP_BASE_URL=https://helpdesk.example.com
LOOKUP_CACHE_TTL=60

# --- Sign-in -----------------------------------------------------------------
AUTH_REQUIRED=true
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
COOKIE_SECURE=true
SESSION_STORE=mysql
# openssl rand -base64 48 -- changing it signs everyone out.
SESSION_SECRET=
# `db` is the bundled MySQL, which creates this database and user on first start.
SESSION_DB_HOST=db
SESSION_DB_PORT=3306
SESSION_DB_USER=arcus_bff
SESSION_DB_PASSWORD=
SESSION_DB_NAME=arcus_bff

# --- MFA, single sign-on, break-glass (backend/README.md, "Single sign-on and MFA")
# Staff (agents, administrators) give an authenticator code after a password.
MFA_REQUIRED=staff
# A UserLocal Administrator that works when single sign-on is down
# (password + mandatory code; every use is in the sign-in audit log).
BREAK_GLASS_LOGINS=
# Microsoft Entra ID: fill these from the app registration, then set
# PASSWORD_SIGN_IN=portal (staff use Microsoft) or break-glass.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://helpdesk.example.com/api/auth/sso/callback
OIDC_EMAIL_CLAIMS=preferred_username,email,upn
OIDC_LABEL=Sign in with Microsoft
SSO_MFA=idp-or-totp
PASSWORD_SIGN_IN=all
# Staff signed in by SSO call iTop as their UserExternal account through this
# header; itop-setup makes iTop's external login read it. Set it (e.g.
# X-Arcus-Remote-User) together with OIDC_ISSUER, then re-run itop-setup.
ITOP_EXTERNAL_AUTH_HEADER=

# --- Mail sent by the BFF (password resets) -----------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Intertec Helpdesk <helpdesk@example.com>"
PASSWORD_RESET_MINUTES=30

# --- Notification rules (mail sent by iTop) -----------------------------------
NOTIFICATION_FROM="Intertec Helpdesk <helpdesk@example.com>"
