# iTop side of docker/docker-compose.prod.yml: iTop, its MySQL, its mail,
# backups. Copy to docker/itop.env (gitignored) and fill in; docs/deployment.md
# explains each one. The service account, the time zone and the sessions
# database are in prod.env (the BFF needs them too) and reach iTop from there.
# A value containing $ must be in single quotes.

# --- MySQL (the bundled `db` service) ----------------------------------------
# Root password of the bundled MySQL; used only by `db` itself.
MYSQL_ROOT_PASSWORD=

# --- iTop's database -----------------------------------------------------------
# `db` is the bundled MySQL; an external one is its host name.
ITOP_DB_HOST=db
ITOP_DB_PORT=3306
ITOP_DB_NAME=itop
ITOP_DB_USER=itop
ITOP_DB_PASSWORD=
# 1 and a CA file path in the container for TLS to an external MySQL.
ITOP_DB_TLS=
ITOP_DB_TLS_CA=

# --- First install (itop-setup) ---------------------------------------------------
# The first administrator: signs in to the platform and creates everyone else.
ITOP_ADMIN_USER=admin
ITOP_ADMIN_PASSWORD=
ITOP_LANGUAGE=EN US
# iTop's own address (its app_root_url). Nobody browses iTop; this is the
# address of the emergency console (docker-compose.prod.itop-admin.yml).
ITOP_APP_ROOT_URL=http://localhost:8089/

# --- iTop's mail (ticket notifications) ------------------------------------------
# Applied by itop-setup. Blank ITOP_SMTP_HOST: iTop sends nothing.
ITOP_SMTP_HOST=smtp.office365.com
ITOP_SMTP_PORT=587
# tls (STARTTLS, 587), ssl (implicit TLS, 465), none (local test mailbox only)
ITOP_SMTP_ENCRYPTION=tls
ITOP_SMTP_USER=
ITOP_SMTP_PASSWORD=
ITOP_MAIL_FROM_ADDRESS=helpdesk@example.com
ITOP_MAIL_FROM_LABEL=Intertec Helpdesk

# --- Backups (the `backup` service) ---------------------------------------------
# Daily, at this time of the container's clock (UTC unless TZ is set).
BACKUP_TIME=02:00
BACKUP_KEEP_DAYS=14
# TZ=Europe/Paris
