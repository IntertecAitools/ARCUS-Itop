<?xml version="1.0" encoding="UTF-8"?>
<!-- Adds Incident Management (ITIL) to the existing itop_prod install.
     Mode is 'upgrade', so the database and its data are kept.
     The only change versus the original install is the two new entries,
     marked NEW below. itop-incident-mgmt-itil depends on itop-config-mgmt,
     itop-tickets and itop-profiles-itil, all of which are already present. -->
<installation>
  <mode>upgrade</mode>
  <optional_steps>
    <log-parameters>1</log-parameters>
    <migrate-before>1</migrate-before>
    <migrate-after>1</migrate-after>
    <setup-audit>1</setup-audit>
    <copy>1</copy>
  </optional_steps>
  <source_dir>datamodels/2.x/</source_dir>
  <datamodel_version>3.4.0</datamodel_version>
  <previous_configuration_file>/var/www/html/conf/production/config-itop.php</previous_configuration_file>
  <extensions_dir>extensions</extensions_dir>
  <target_env>production</target_env>
  <workspace_dir></workspace_dir>
  <database>
    <server>host.docker.internal</server>
    <user>root</user>
    <pwd></pwd>
    <name>itop_prod</name>
    <db_tls_enabled></db_tls_enabled>
    <db_tls_ca></db_tls_ca>
    <prefix></prefix>
  </database>
  <url>http://localhost:8081/</url>
  <graphviz_path>/usr/bin/dot</graphviz_path>
  <admin_account>
    <user>admin</user>
    <pwd>Weftbase#2026</pwd>
    <language>EN US</language>
  </admin_account>
  <language>EN US</language>
  <selected_modules type="array">
    <item>authent-cas</item>
    <item>authent-external</item>
    <item>authent-ldap</item>
    <item>authent-local</item>
