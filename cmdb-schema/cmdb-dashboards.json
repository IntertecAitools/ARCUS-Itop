    {
     "id": "AuditConfiguration_row0_col1_1",
     "kind": "text",
     "text": "Audit category defines a scope of objects which needs to be audited.\nIt groups all audit rules applying to that object scope",
     "title": ""
    },
    {
     "class": "AuditCategory",
     "id": "AuditConfiguration_row0_col1_2",
     "kind": "badge",
     "title": ""
    },
    {
     "id": "AuditConfiguration_row0_col2_1",
     "kind": "text",
     "text": "An audit rule corresponds a single check within an audit category.\nIt is applied on the scope of objects defined by the audit category",
     "title": ""
    },
    {
     "class": "AuditRule",
     "id": "AuditConfiguration_row0_col2_2",
     "kind": "badge",
     "title": ""
