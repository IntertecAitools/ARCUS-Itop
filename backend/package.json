{
  "name": "intertec-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Intertec backend - a BFF over the iTop 3.4 REST/JSON API",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "schema:pull": "node scripts/pull-schema.mjs",
    "smoke": "node --import tsx scripts/smoke.ts",
    "api:check": "node scripts/api-check.mjs",
    "idp:dev": "node scripts/dev-idp.mjs",
    "e2e:sso": "node --import tsx scripts/e2e-sso.mjs",
    "approvals:setup": "node --import tsx scripts/approvals-setup.ts",
    "tenants": "node --import tsx scripts/tenants.ts",
    "e2e:tenancy": "node scripts/e2e-tenancy.mjs",
    "e2e:tenant-admin": "node scripts/e2e-tenant-admin.mjs",
    "e2e:problems": "node --import tsx scripts/e2e-problems.mjs",
    "e2e:changes": "node --import tsx scripts/e2e-changes.mjs",
    "e2e:requests": "node --import tsx scripts/e2e-requests.mjs",
    "e2e:incidents": "node --import tsx scripts/e2e-incidents.mjs",
    "e2e:sla": "node --import tsx scripts/e2e-sla.mjs",
    "e2e:business-hours": "node --import tsx scripts/e2e-business-hours.mjs",
    "e2e:rights": "node --import tsx scripts/e2e-lifecycle-rights.mjs",
    "e2e:rca": "node --import tsx scripts/e2e-rca.mjs",
    "e2e:dispatch": "node --import tsx scripts/e2e-dispatch.mjs",
    "e2e:data-import": "node --import tsx scripts/e2e-data-import.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/multipart": "^10.1.3",
    "fastify": "^5.2.1",
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.7",
    "openid-client": "^6.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "oidc-provider": "^9.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
