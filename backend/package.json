{
  "name": "intertec-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Intertec backend - a BFF over the iTop 3.4 REST/JSON API",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "schema:pull": "node scripts/pull-schema.mjs",
    "smoke": "node --import tsx scripts/smoke.ts",
    "api:check": "node scripts/api-check.mjs",
    "idp:dev": "node scripts/dev-idp.mjs",
    "e2e:sso": "node --import tsx scripts/e2e-sso.mjs",
    "approvals:setup": "node --import tsx scripts/approvals-setup.ts",
    "tenants": "node --import tsx scripts/tenants.ts",
    "e2e:tenancy": "node scripts/e2e-tenancy.mjs",
    "e2e:problems": "node scripts/e2e-problems.mjs",
    "e2e:requests": "node --import tsx scripts/e2e-requests.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.3",
    "fastify": "^5.2.1",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.7",
    "openid-client": "^6.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "oidc-provider": "^9.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
