{
  "name": "intertec-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Intertec backend - a BFF over the iTop 3.4 REST/JSON API",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "schema:pull": "node scripts/pull-schema.mjs",
    "smoke": "node --import tsx scripts/smoke.ts",
    "api:check": "node scripts/api-check.mjs"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
