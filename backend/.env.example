# --- iTop upstream -----------------------------------------------------------
# Base URL of the iTop instance. No trailing slash. The BFF appends
# /webservices/rest.php itself.
ITOP_BASE_URL=http://localhost:8080

# Credentials for the REST account.
#
# IMPORTANT: iTop's `secure_rest_services` setting defaults to TRUE (see
# core/config.class.inc.php), so this user MUST hold the "REST Services User"
# profile or every call comes back with code 1 / UNAUTHORIZED. Token auth is
# NOT a substitute here: `allow_rest_services_via_tokens` defaults to false and
# no token-auth module is installed in this instance.
ITOP_USER=admin
ITOP_PASSWORD=change-me

# REST dialect. 1.4 adds the `limit`/`page` parameters that pagination needs,
# so do not lower this without also disabling pagination.
ITOP_REST_VERSION=1.4

# Upstream request timeout (ms) and retry budget for transient failures.
ITOP_TIMEOUT_MS=30000
ITOP_RETRIES=2

# iTop's time zone: the 'timezone' setting in iTop's config-itop.php
# (iTop's default is Europe/Paris). iTop stores dates as local text in it;
# the BFF uses this to turn them into exact times for the browser.
ITOP_TIMEZONE=Europe/Paris

# --- BFF ---------------------------------------------------------------------
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info
# Only behind reverse proxies you control: client addresses (used to
# rate-limit sign-ins and password-reset requests) are then read from
# X-Forwarded-For. A number trusts that many proxy hops (best: the client
# cannot pick its own address), true trusts every hop, or list the proxies'
# addresses/CIDRs.
TRUST_PROXY=false

# Comma-separated list of allowed browser origins, or * for any.
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:5173,http://localhost:4173

# Written into every create/update/delete as iTop's mandatory tracking comment
# when the caller does not supply one.
ITOP_DEFAULT_COMMENT=via arcus-backend

# Path to the compiled CMDB schema produced by cmdb-schema/extract-schema.py.
CMDB_SCHEMA_PATH=../cmdb-schema/cmdb-schema.json

# Seconds to cache lookup/picker option lists. 0 disables caching.
LOOKUP_CACHE_TTL=60

# Which organisation new records belong to when the UI does not ask.
# Leave blank and the BFF resolves it: the organisation of the account in
# ITOP_USER, else the only organisation in the instance. It refuses to guess
# when several exist -- filing tickets against an arbitrary company silently
# is worse than a clear error.
ITOP_DEFAULT_ORG_ID=

# --- Sign-in -----------------------------------------------------------------
# Every /api route needs a session; staff calls run as the signed-in iTop user.
AUTH_REQUIRED=true
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
# Must be true when the BFF is served over HTTPS.
COOKIE_SECURE=false

# Where sessions live. `memory` signs everyone out when the BFF restarts and
# allows only one BFF instance. `mysql` keeps them across restarts and shares
# them between instances, in table `bff_sessions` (created on start) of a
# database of its own -- not iTop's. A session carries the user's iTop
# password, so it is stored encrypted with SESSION_SECRET (AES-256-GCM); keep
# that secret out of the database's reach, and changing it signs everyone out.
SESSION_STORE=memory
# SESSION_SECRET=           # openssl rand -base64 48
# SESSION_DB_HOST=127.0.0.1
# SESSION_DB_PORT=3306
# SESSION_DB_USER=
# SESSION_DB_PASSWORD=
# SESSION_DB_NAME=arcus_bff

# --- Root-cause help on problems ---------------------------------------------
# How far before a problem's first incident a change still counts as a suspect.
# RCA_LOOKBACK_HOURS=72
# "Draft with AI" (Claude). No credentials: the button is hidden; the evidence
# still works. Never commit a real key or token.
# Which service runs Claude: anthropic (the Claude API, default) or bedrock.
# RCA_AI_PROVIDER=anthropic
# The Claude API:
# ANTHROPIC_API_KEY=
# RCA_AI_MODEL=claude-opus-5-5
# Amazon Bedrock (RCA_AI_PROVIDER=bedrock): a Bedrock API key, or the usual
# AWS credentials (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, AWS_PROFILE, a role).
# AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=
# BEDROCK_MODEL_ID=anthropic.claude-sonnet-5
# RCA_AI=on
# RCA_AI_EFFORT=high
# Also send private logs (off: public logs only).
# RCA_AI_PRIVATE_LOGS=off
# Tenant ids (TENANCY=on) with AI drafting off, comma-separated.
# RCA_AI_DISABLED_TENANTS=

# --- Multi-tenancy -------------------------------------------------------------
# Several customers on one platform: every iTop read and write is held to the
# signed-in user's tenant (its iTop organisations). Tenants live in the BFF
# database (needs SESSION_STORE=mysql) or in TENANTS_FILE; manage them with
# `npm run tenants`. See README.md, "Multi-tenancy".
# TENANCY=off
# TENANTS_FILE=tenants.json
# Accounts that run the platform rather than belong to a customer.
# PLATFORM_LOGINS=admin
# End users at an email domain a tenant claims may create their own portal
# account (the mailed set-password link proves the address; needs the
# password-reset email settings below), and an unknown single sign-on address
# at such a domain gets one. See README.md, "Self-registration".
# SELF_REGISTRATION=off

# --- Forgot password by email -------------------------------------------------
# Off until SMTP_HOST is set; the sign-in page then offers "Forgot password?".
# A user enters their login or email; a local account with an email address
# gets a one-time link, valid PASSWORD_RESET_MINUTES. LDAP and external
# accounts are not reset here (their password lives elsewhere). Reset links
# are stored like sessions (SESSION_STORE): memory, or table
# bff_password_resets in the session database.
# SMTP_HOST=
# SMTP_PORT=587               # 465 = implicit TLS; 587/25 = STARTTLS
# SMTP_SECURE=                # defaults to true on 465, false otherwise
# SMTP_REQUIRE_TLS=true       # false only for a local test mailbox
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Intertec Helpdesk <helpdesk@example.com>"
# APP_BASE_URL=http://localhost:5173   # the frontend's public address
# PASSWORD_RESET_MINUTES=30

# --- Notification emails (sent by iTop) ----------------------------------------
# The sender on notification rules made in the platform: "Label <address>".
# Defaults to MAIL_FROM. iTop sends these through its own mail settings
# (config-itop.php), and links in them point at APP_BASE_URL.
# NOTIFICATION_FROM="Intertec Helpdesk <helpdesk@example.com>"

# --- MFA, single sign-on, break-glass ------------------------------------------
# See backend/README.md, "Single sign-on and MFA".
#
# Who gives an authenticator (TOTP) code after a PASSWORD sign-in:
#   staff (agents and administrators; the default), admin, or off.
# Break-glass accounts always do, and so does anyone who has enrolled.
# Scripted local tests that sign in with a password (frontend `npm run
# e2e:live`, api:check) need MFA_REQUIRED=off on the BFF they use.
MFA_REQUIRED=staff
# The name authenticator apps show next to the code.
# MFA_ISSUER=Arcus Helpdesk
#
# Who may sign in with a password: all (default), portal (end users and
# break-glass; staff must use single sign-on) or break-glass (only the
# break-glass accounts). Anything but `all` needs OIDC_ISSUER.
# PASSWORD_SIGN_IN=all
# iTop logins (UserLocal, Administrator) that work when single sign-on is
# down: password + mandatory authenticator code, every use in the sign-in
# audit log. Comma-separated.
# BREAK_GLASS_LOGINS=breakglass
#
# Single sign-on (OpenID Connect, Authorization Code + PKCE). Off until
# OIDC_ISSUER is set. For Microsoft Entra ID:
#   OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#   OIDC_EMAIL_CLAIMS=preferred_username,email,upn
# For the local dev IdP (npm run idp:dev):
#   OIDC_ISSUER=http://127.0.0.1:3027 and OIDC_ALLOW_HTTP=true
# OIDC_ISSUER=
# OIDC_ALLOW_HTTP=false
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# The BFF's callback, exactly as registered at the IdP:
# OIDC_REDIRECT_URI=https://helpdesk.example.com/api/auth/sso/callback
# OIDC_SCOPES=openid profile email
# Claims tried in order for the user's email (matched to the iTop account's email):
# OIDC_EMAIL_CLAIMS=email,preferred_username,upn
# OIDC_LABEL=Sign in with Microsoft
# Where the browser lands after signing in (defaults to APP_BASE_URL):
# OIDC_APP_URL=
# MFA for staff signing in this way: idp-or-totp (trust the IdP's `amr`
# claim when it shows MFA, else ask for our code; the default), idp (refuse
# without the IdP's MFA), off (the IdP enforces MFA itself).
# SSO_MFA=idp-or-totp
# `amr` values that count as MFA:
# OIDC_MFA_AMR=mfa,otp,hwk,sms,fido
#
# Staff signed in by SSO have no iTop password: their iTop calls carry their
# login in this header, which iTop's "external" login must read
# (config-itop.php: 'ext_auth_variable' => "$_SERVER['HTTP_X_ARCUS_REMOTE_USER']";
# the production stack's itop-setup sets it from this same variable).
# Their accounts must be UserExternal. Unset: staff cannot use SSO.
# ITOP_EXTERNAL_AUTH_HEADER=X-Arcus-Remote-User
