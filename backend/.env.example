# --- iTop upstream -----------------------------------------------------------
# Base URL of the iTop instance. No trailing slash. The BFF appends
# /webservices/rest.php itself.
ITOP_BASE_URL=http://localhost:8080

# Credentials for the REST account.
#
# IMPORTANT: iTop's `secure_rest_services` setting defaults to TRUE (see
# core/config.class.inc.php), so this user MUST hold the "REST Services User"
# profile or every call comes back with code 1 / UNAUTHORIZED. Token auth is
# NOT a substitute here: `allow_rest_services_via_tokens` defaults to false and
# no token-auth module is installed in this instance.
ITOP_USER=admin
ITOP_PASSWORD=change-me

# REST dialect. 1.4 adds the `limit`/`page` parameters that pagination needs,
# so do not lower this without also disabling pagination.
ITOP_REST_VERSION=1.4

# Upstream request timeout (ms) and retry budget for transient failures.
ITOP_TIMEOUT_MS=30000
ITOP_RETRIES=2

# --- BFF ---------------------------------------------------------------------
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# Comma-separated list of allowed browser origins, or * for any.
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:5173,http://localhost:4173

# Written into every create/update/delete as iTop's mandatory tracking comment
# when the caller does not supply one.
ITOP_DEFAULT_COMMENT=via arcus-backend

# Path to the compiled CMDB schema produced by cmdb-schema/extract-schema.py.
CMDB_SCHEMA_PATH=../cmdb-schema/cmdb-schema.json

# Seconds to cache lookup/picker option lists. 0 disables caching.
LOOKUP_CACHE_TTL=60
