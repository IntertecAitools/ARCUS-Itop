# Copy to .env. Every value here is also the built-in default, so the app runs
# correctly against the real stack even without a .env file.
#
# live = the real BFF on :4000 (the default) | mock = MSW fake API, no BFF needed
# Set `mock` only when you deliberately want fabricated data.
VITE_API_MODE=live
VITE_BFF_URL=http://localhost:4000/api
VITE_APP_NAME=Intertec
VITE_PLATFORM_NAME=iTop
VITE_DEFAULT_LOCALE=en
