{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/record-test-run.mjs\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Recording test run"
          }
        ]
      }
    ]
  }
}
